# ─── OOJ Automation .gitignore ───────────────────────────────────────────
# Keep source, docs, tests, and config. Exclude operational data, secrets,
# caches, and build artifacts. This is internal Amazon tooling (GitFarm).

# ── Captured operational data (NEVER commit — contains real TIDs, zones,
#    station screenshots, exported CSV/XLSX from SCC/PNAMA/DSR/ADS/etc.) ──
tools/captures/
tools/output/
**/captures/
*.download.tmp

# ── Secrets / credentials ──
*.pem
*.key
*.pfx
.env
.env.*
secrets.json
credentials.json
**/cookies*.json
**/*token*.json

# ── Local memory DB (binary, machine-local) ──
.neurotrace/neurotrace.db
*.db-journal
*.db-wal
*.db-shm

# ── Python caches / build artifacts ──
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ── Test / tooling caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
report.xml

# ── Editor / OS cruft ──
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.swp
*~

# ── Logs & temp ──
*.log
*.tmp
*.tmp.txt
check_env.tmp.txt

# ── Stale/duplicate doc artifact (Docs/PRD-OOJ-Automation.md is the source of truth) ──
# Anchored to root so an intentional Docs/-level file of the same name is not matched.
/PRD-OOJ-Automation.docx

# ── Agent planning/review scratch (not part of the automation) ──
.agents/
